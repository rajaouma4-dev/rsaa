# Turso credentials are backend-only. Never add these values to the Android app.
TURSO_DATABASE_URL=libsql://YOUR_DB_NAME-YOUR_ORG.turso.io
TURSO_AUTH_TOKEN=PASTE_TURSO_TOKEN_HERE

# TLS signaling listener (custom newline-framed JSON protocol over TLS/TCP; not HTTP)
SIGNAL_BIND=0.0.0.0:7443
MAX_SIGNAL_CONNECTIONS=500
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key

# Comma-separated ICE URLs. In production use your own TURN service and ephemeral credentials.
ICE_URLS=stun:stun.l.google.com:19302
MAX_SIGNAL_FRAME_BYTES=65536

# Exact IPs/CIDRs of your actual trusted reverse proxies only. Empty = ignore X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
